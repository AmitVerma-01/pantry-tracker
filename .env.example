# Firebase Configuration (client — safe to expose in browser)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_DATABASE_URL=https://your_project_id.firebaseio.com

# Server-only secrets (never use VITE_ prefix — not bundled into the browser)
GEMINI_API_KEY=your_gemini_api_key_here
# Same web API key as above, used server-side to verify Firebase auth tokens
FIREBASE_API_KEY=your_firebase_api_key_here
# Optional: force a preferred Gemini model (falls back through free-tier chain)
# GEMINI_MODEL=gemini-3.5-flash
