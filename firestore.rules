rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to validate item data on create
    function isValidItemCreate() {
      let data = request.resource.data;
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.email is string &&
             data.itemName is string &&
             data.itemName.size() > 0 &&
             data.quantity is number &&
             data.quantity > 0 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }
    
    // Helper function to validate item data on update
    function isValidItemUpdate() {
      let data = request.resource.data;
      // Ensure userId and email cannot be changed
      return data.userId == resource.data.userId &&
             data.email == resource.data.email &&
             data.itemName is string &&
             data.itemName.size() > 0 &&
             data.quantity is number &&
             data.quantity > 0 &&
             data.updatedAt is timestamp;
    }
    
    // Helper function to validate recipe data on create
    function isValidRecipeCreate() {
      let data = request.resource.data;
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.ingredients is list &&
             data.ingredients.size() > 0 &&
             data.ingredientsHash is string &&
             data.ingredientsHash.size() > 0 &&
             data.recipeHtml is string &&
             data.recipeHtml.size() > 0 &&
             data.createdAt is timestamp &&
             data.lastAccessedAt is timestamp;
    }
    
    // Items collection rules
    match /items/{itemId} {
      // Users can only read their own items
      allow read: if isAuthenticated() && 
                     isOwner(resource.data.userId);
      
      // Users can only create items with their own userId and valid data
      allow create: if isAuthenticated() && 
                       isValidItemCreate();
      
      // Users can only update their own items with valid data
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) &&
                       isValidItemUpdate();
      
      // Users can only delete their own items
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.userId);
    }
    
    // Recipes collection rules
    match /recipes/{recipeId} {
      // Users can only read their own recipes
      allow read: if isAuthenticated() && 
                     isOwner(resource.data.userId);
      
      // Users can only create recipes with their own userId and valid data
      allow create: if isAuthenticated() && 
                       isValidRecipeCreate();
      
      // Users can update their own recipes (e.g., lastAccessedAt)
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId) &&
                       request.resource.data.userId == resource.data.userId;
      
      // Users can only delete their own recipes
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.userId);
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
